{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homeview-sentinel.local/contracts/event.v1.schema.json",
  "title": "HomeView Sentinel event, version 1",
  "description": "Published on sentinel/v1/events/<camera_id> with QoS 1, not retained. Times are UTC from the Mac's clock. The snapshot is referenced by a path relative to the snapshots folder, never embedded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "event_id", "type", "occurred_at", "camera", "zone", "object", "dwell", "snapshot"],
  "properties": {
    "schema": {"const": "sentinel.event/v1"},
    "event_id": {"$ref": "#/$defs/uuid"},
    "type": {"enum": ["dwell.started", "dwell.ended"]},
    "occurred_at": {"$ref": "#/$defs/utc_time"},
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "channel"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1},
        "channel": {"type": "integer", "minimum": 1, "maximum": 8}
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "with_rider", "track_id", "confidence"],
      "properties": {
        "class": {"enum": ["car", "motorcycle"]},
        "with_rider": {"type": "boolean", "description": "Always false for a car."},
        "track_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*-[0-9]+$"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "dwell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["since", "seconds"],
      "properties": {
        "since": {"$ref": "#/$defs/utc_time"},
        "seconds": {"type": "integer", "minimum": 0, "description": "Seconds stopped so far (dwell.started) or in total (dwell.ended)."}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "width", "height"],
      "properties": {
        "file": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z-[a-z0-9][a-z0-9-]*-[0-9]+\\.jpg$"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "started_event_id": {"$ref": "#/$defs/uuid"}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "dwell.ended"}}},
      "then": {"required": ["started_event_id"]},
      "else": {"not": {"required": ["started_event_id"]}}
    },
    {
      "if": {"properties": {"object": {"properties": {"class": {"const": "car"}}}}},
      "then": {"properties": {"object": {"properties": {"with_rider": {"const": false}}}}}
    }
  ],
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "utc_time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
  }
}
